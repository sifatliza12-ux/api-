# Copy this file to .env for local development. On Railway, set these as
# service variables instead — do not commit a real .env.

# --- Required everywhere ---

# Any random long string. Signs and verifies every auth token; the server
# refuses to start without it (see server.js).
JWT_SECRET=

# --- Server ---

# Railway injects PORT automatically — you don't need to set this on
# Railway. Only relevant for local development.
PORT=5000

# development | production. Controls the JWT_SECRET/CORS_ORIGIN checks
# below and Playwright's default headless mode. Railway does not set this
# automatically — set it to `production` yourself as a service variable.
NODE_ENV=development

# --- CORS (production only) ---

# Comma-separated list of allowed origins, e.g. the extension's own
# chrome-extension://<id> origin once you know its id. Required in
# production — with NODE_ENV=production and this unset, the API rejects
# every cross-origin request rather than allowing any origin through.
# Not needed in development, where CORS is unrestricted by default.
CORS_ORIGIN=

# --- Playwright / workflow replay ("Run API") ---

# true | false. Controls whether the replay browser is visible. Defaults to
# headless automatically when NODE_ENV=production (Railway has no display),
# and to visible in local development. Set explicitly to override either
# way; usually you don't need to set this at all.
FORGEFLOW_HEADLESS=

# --- Database persistence (production only) ---

# Absolute path to a persistent directory for the SQLite database file.
# Railway's filesystem is wiped on every deploy/restart unless the database
# lives on a mounted Volume — set this to that Volume's mount path (see
# README.md's Railway deployment steps). Leave unset for local development;
# it falls back to backend/data/forgeflow.db as before.
DATABASE_DIR=

# --- Optional ---

# Only needed if you use the Claude-assisted field extraction path, or set
# AI_PROVIDER=anthropic below; the default rule-based parameterizer and the
# default AI Creator provider both work without it.
ANTHROPIC_API_KEY=

# --- AI API Creator (V2) provider selection ---

# local (default) | rule-based | ollama | anthropic | groq. Selects which
# AIProvider backs the AI Creator's natural-language understanding (see
# backend/services/aiProviders/). "local" and "rule-based" both use the
# zero-cost, zero-dependency regex-based provider — Anthropic/Groq are NEVER
# used just because their API key is set; you must select them explicitly
# here.
AI_PROVIDER=local

# Only used when AI_PROVIDER=ollama. Base URL of a locally running Ollama
# server.
OLLAMA_BASE_URL=http://localhost:11434

# Only used when AI_PROVIDER=ollama. The exact model name as shown by
# `ollama list` (e.g. llama3.1:8b-instruct) — not assumed/hard-coded.
OLLAMA_MODEL=

# Only used when AI_PROVIDER=groq. Groq is a cloud-hosted, OpenAI-compatible
# chat completions API — a fast alternative to a local Ollama install on
# machines where CPU-only local inference isn't practical. Get a key at
# https://console.groq.com/keys. Backend-only: this key is never sent to or
# read by the extension/frontend.
GROQ_API_KEY=

# Only used when AI_PROVIDER=groq. The exact model id as shown by Groq's
# model list (https://console.groq.com/docs/models) — not assumed/hard-coded.
# As of this writing, "llama-3.3-70b-versatile" and "llama-3.1-8b-instant"
# are both current, but check Groq's own docs for what's actually available
# on your account, since hosted model availability changes over time.
GROQ_MODEL=

# Optional. Only used when AI_PROVIDER=groq. Overrides Groq's API base URL —
# leave unset unless you have a specific reason to point elsewhere.
GROQ_BASE_URL=

# Optional. Only used when AI_PROVIDER=groq. Milliseconds to wait for a
# single Groq response before giving up. Defaults to 60000 (60s) — far
# below Ollama's own 600s default, since Groq's cloud inference is
# dramatically faster than CPU-only local inference.
GROQ_GENERATION_TIMEOUT_MS=
